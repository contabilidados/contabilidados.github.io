<%
const cont = {};
for (const it of items) for (const c of (it.categories || [])) cont[c] = (cont[c] || 0) + 1;
const top = Object.entries(cont).sort((x, y) => y[1] - x[1] || x[0].localeCompare(y[0], "pt")).slice(0, 12);
%>
```{=html}
<div class="nv-topicos"><span>Tópicos mais frequentes:</span>
<% for (const [c, n] of top) { %><a class="nv-topico" href="posts.html#tema=<%= encodeURIComponent(c) %>"><%- c %> <span><%- n %></span></a><% } %>
</div>
```
